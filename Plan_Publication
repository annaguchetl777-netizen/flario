  <script>
    var KEY = "flario-vykat-checks-v1";
    var buttons = document.querySelectorAll("#filters button");
    var rows = document.querySelectorAll(".stage tbody tr");
    var stages = document.querySelectorAll(".stage");

    function loadState() {
      try { return JSON.parse(localStorage.getItem(KEY) || "{}"); }
      catch (e) { return {}; }
    }

    function saveState(state) {
      localStorage.setItem(KEY, JSON.stringify(state));
    }

    var state = loadState();
    rows.forEach(function (row) {
      var id = row.getAttribute("data-id");
      var cb = row.querySelector("input.tick");
      if (!id || !cb) return;
      cb.checked = !!state[id];
      row.classList.toggle("done", cb.checked);
      cb.addEventListener("change", function () {
        row.classList.toggle("done", cb.checked);
        if (cb.checked) state[id] = true;
        else delete state[id];
        saveState(state);
      });
    });

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        buttons.forEach(function (b) { b.classList.remove("active"); });
        btn.classList.add("active");
        var who = btn.getAttribute("data-who");
        rows.forEach(function (row) {
          row.style.display = (who === "all" || row.getAttribute("data-who") === who) ? "" : "none";
        });
        stages.forEach(function (stage) {
          var visible = Array.prototype.some.call(stage.querySelectorAll("tbody tr"), function (row) {
            return row.style.display !== "none";
          });
          stage.style.display = visible ? "" : "none";
        });
      });
    });
  </script>
</body>
</html>
