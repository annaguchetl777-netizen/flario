<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Выкат приложения Flario</title>
  <style>
    :root {
      --crimson: #af004e;
      --ink: #1a1216;
      --muted: #5c4f56;
      --line: #e6dce1;
      --paper: #faf7f9;
      --white: #ffffff;
      --warn: #f7efe4;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font: 15px/1.45 "Segoe UI", system-ui, sans-serif;
      color: var(--ink);
      background: var(--paper);
    }
    header {
      background: var(--white);
      border-bottom: 1px solid var(--line);
      padding: 28px 32px 20px;
    }
    h1 { margin: 8px 0 10px; font-size: 28px; font-weight: 700; }
    h2 { margin: 36px 0 10px; font-size: 20px; }
    h3 { margin: 0; font-size: 18px; }
    p, li { color: var(--muted); }
    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px 64px; }
    .meta { color: var(--muted); font-size: 13px; }
    .pill {
      display: inline-block;
      background: var(--crimson);
      color: #fff;
      font-size: 12px;
      font-weight: 650;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .pill-ghost {
      background: transparent;
      color: var(--crimson);
      border: 1px solid var(--crimson);
    }
    .note {
      background: var(--warn);
      border-left: 4px solid var(--crimson);
      padding: 12px 16px;
      margin: 16px 0 0;
    }
    .note strong { color: var(--ink); }
    .timeline {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      margin: 20px 0 0;
    }
    .timeline a {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--white);
      border: 1px solid var(--line);
      padding: 10px 12px;
      min-height: 86px;
    }
    .timeline a:hover { border-color: var(--crimson); }
    .timeline .n {
      font-size: 11px;
      font-weight: 700;
      color: var(--crimson);
      letter-spacing: 0.04em;
    }
    .timeline .d { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .timeline .t { font-size: 13px; font-weight: 650; margin-top: 4px; color: var(--ink); }
    .stage {
      margin-top: 32px;
      background: var(--white);
      border: 1px solid var(--line);
    }
    .stage-head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      padding: 16px 18px;
      border-bottom: 1px solid var(--line);
    }
    .stage-head p { margin: 6px 0 0; }
    .stage table { border: 0; }
    .stage th { position: static; }
    table {
      width: 100%;
      border-collapse: collapse;
      background: var(--white);
      font-size: 13px;
    }
    th, td {
      border: 1px solid var(--line);
      padding: 10px 12px;
      vertical-align: top;
      text-align: left;
    }
    th {
      background: var(--crimson);
      color: #fff;
      font-weight: 650;
    }
    tr:nth-child(even) td { background: #fcfafb; }
    th.check, td.check {
      width: 52px;
      text-align: center;
      vertical-align: middle;
    }
    input.tick {
      width: 20px;
      height: 20px;
      margin: 0;
      cursor: pointer;
      accent-color: var(--crimson);
    }
    tr.done td { color: var(--muted); }
    tr.done td:not(.check) { text-decoration: line-through; }
    .who-vika td.who { box-shadow: inset 3px 0 0 #af004e; }
    .who-marina td.who { box-shadow: inset 3px 0 0 #27500a; }
    .who-liza td.who { box-shadow: inset 3px 0 0 #2aabee; }
    .filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 16px 0; }
    .filters button {
      border: 1px solid var(--line);
      background: var(--white);
      padding: 6px 12px;
      cursor: pointer;
      font: inherit;
    }
    .filters button.active { background: var(--crimson); color: #fff; border-color: var(--crimson); }
    .filters .hint { font-size: 12px; color: var(--muted); }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .card {
      background: var(--white);
      border: 1px solid var(--line);
      padding: 16px 18px;
    }
    .card h3 { margin: 0 0 8px; font-size: 16px; }
    footer { margin-top: 40px; font-size: 12px; color: var(--muted); }
    @media (max-width: 900px) {
      .timeline { grid-template-columns: 1fr 1fr; }
      .grid { grid-template-columns: 1fr; }
      header, .wrap { padding-left: 16px; padding-right: 16px; }
    }
    @media print {
      .filters { display: none; }
      .stage { break-inside: avoid; }
    }
  </style>
</head>
